<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="renvault"
        Arguments=""
        InstallLocation="C:\Program Files\Lauren Iraci\RenVault">
    </Installer>
    <PackageInformation
        PackageName="RenVault"
        PackageDisplayName="RenVault"
        PublisherName="CN=Lauren Iraci"
        PublisherDisplayName="Lauren Iraci"
        Version="0.1.0.0"
        PackageDescription="An unofficial cross-platform Apple Passwords client for managing your credentials securely">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.lauren.renvault"
                Description="An unofficial cross-platform Apple Passwords client for managing your credentials securely"
                DisplayName="RenVault"
                ExecutableName="renvault"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>RenVault</DisplayName>
            <PublisherDisplayName>Lauren Iraci</PublisherDisplayName>
            <Description>An unofficial cross-platform Apple Passwords client for managing your credentials securely</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="renvault.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
